{
  "name": "igemerdb",
  "version": "2.0.0-beta.1",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:data",
    "dev": "vite",
    "build:data": "node tools/build_web_data.mjs",
    "prebuild": "npm run build:data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scraper": "cd tools/igem_scraper && python -m unittest discover -s tests -v",
    "test:e2e": "python tools/e2e/smoke.py",
    "validate:data": "python tools/igem_scraper/cli.py validate-export public/data/igem.json",
    "validate:web-data": "node tools/validate_web_data.mjs",
    "test:watch": "vitest",
    "lint": "eslint \"src/app/**/*.{ts,tsx}\" \"src/main.tsx\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:all": "npm run check && npm run test:scraper && npm run validate:data && npm run validate:web-data",
    "test:coverage": "vitest run --coverage",
    "test:axe": "python tools/e2e/axe_scan.py"
  },
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "jsdom": "^30.0.1",
    "less": "^4.2.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
