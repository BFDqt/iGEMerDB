# Postgres connection string
# Example: postgresql+psycopg://user:pass@localhost:5432/igemerdb
# Relative SQLite paths are resolved from this scraper directory.
# SQLite (for a local full snapshot): sqlite:///data/igem_full.db
DATABASE_URL=

# Polite scraping
USER_AGENT=iGEMerDbScraper/0.1 (+contact: you@example.com)
REQUESTS_PER_SECOND=1.5
TIMEOUT_SECONDS=30
MAX_RETRIES=4
MAX_LIVE_AGE_HOURS=48

# Years
START_YEAR=2004
END_YEAR=2026
